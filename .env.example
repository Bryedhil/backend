PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student_expenseList_db
JWT_SECRET=replace_this_with_a_long_random_secret_before_use

# Optional: set these before running npm run create:admin
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=use_a_long_unique_password_here
# CLASS_SECTION=BSIT 3-C

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash



# Temporary password applied after a verified reset link is opened (10+ characters).
# Choose a strong temporary value and keep this secret. Users must change it after signing in.
DEFAULT_RESET_PASSWORD=ChangeThisTemporaryPassword2026!

# SMTP is required for Forgot Password emails. Example values are for your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
SMTP_FROM=ClassFunds Support <support@example.com>
FRONTEND_URL=http://localhost:5173
